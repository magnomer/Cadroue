# Project-internal material
/docs-internal/
/docs-work/
/snapshots/
/import/

# Temporary gitignore
/docs/
/sample/local/


# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Ignore root-level files and folders by default.
/*

