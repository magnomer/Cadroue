<Window x:Class="Cadroue.UIShell.PMainWindow.PWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pControlBar="clr-namespace:Cadroue.UIShell.PControlBar"
        xmlns:pMainArea="clr-namespace:Cadroue.UIShell.PMainArea"
        Title="Cadroue"
        Icon="/PAssets/PProgram/PProgramIcon.ico"
        Width="1280"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#DCE8F7"
        BorderThickness="0"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowDrop="True">
    <Grid Background="#DCE8F7" Margin="0" AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <pControlBar:PToolbar x:Name="pControlBar" Grid.Row="0" />
        <pMainArea:PConsole x:Name="pConsole" Grid.Row="1" Margin="0,-1,0,0" />
        <pMainArea:PDeck x:Name="pDeck" Grid.Row="2" />

    </Grid>
</Window>
