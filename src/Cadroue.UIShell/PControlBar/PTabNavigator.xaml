<UserControl x:Class="Cadroue.UIShell.PControlBar.PRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pControlBar="clr-namespace:Cadroue.UIShell.PControlBar"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="pTabTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2B3443" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PTabSelectState}" Value="True">
                    <Setter Property="Foreground" Value="#111827" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="pTabNameTextStyle" TargetType="TextBlock" BasedOn="{StaticResource pTabTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PTabNameActive}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="pTabNameBoxStyle" TargetType="TextBox">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#4C86F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="#4C86F7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PTabNameActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="pTabCloseStyle" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="pTabFrameHorizontalStyle" TargetType="Border">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="142" />
            <Setter Property="Padding" Value="11,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9,9,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF4FC" />
                    <Setter Property="BorderBrush" Value="#D5E0ED" />
                </Trigger>
                <DataTrigger Binding="{Binding PTabSelectState}" Value="True">
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="#C9D6E5" />
                    <Setter Property="BorderThickness" Value="1,1,1,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="pTabFrameVerticalStyle" TargetType="Border">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="10,0,7,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9,0,0,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF4FC" />
                    <Setter Property="BorderBrush" Value="#D5E0ED" />
                </Trigger>
                <DataTrigger Binding="{Binding PTabSelectState}" Value="True">
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="#C9D6E5" />
                    <Setter Property="BorderThickness" Value="1,1,0,1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="pTabAddHorizontalStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="5,12,8,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#26364A" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pTabAddFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9,9,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="pTabAddFrame" Property="Background" Value="#EEF4FC"/><Setter TargetName="pTabAddFrame" Property="BorderBrush" Value="#D5E0ED"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="pTabAddFrame" Property="Background" Value="#FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="pTabAddVerticalStyle" TargetType="Button" BasedOn="{StaticResource pTabAddHorizontalStyle}">
            <Setter Property="Width" Value="164" />
            <Setter Property="Margin" Value="8,4,8,8" />
        </Style>
        <ItemsPanelTemplate x:Key="pHorizontalItemsPanel"><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="pVerticalItemsPanel"><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
        <DataTemplate x:Key="pHorizontalTabTemplate" DataType="{x:Type pControlBar:PTabRecord}">
            <Grid Margin="0,12,0,0">
                <Border Style="{StaticResource pTabFrameHorizontalStyle}" MouseEnter="PTabEnterHandle" MouseLeave="PTabLeaveHandle" MouseLeftButtonDown="PTabPressHandle" MouseMove="PTabMoveHandle" MouseLeftButtonUp="PTabReleaseHandle">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Image Width="17" Height="17" Source="{Binding PTabIconSource}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource pTabNameTextStyle}" Text="{Binding PTabTitle}" Tag="pTabNameText" />
                        <TextBox Grid.Column="1" Style="{StaticResource pTabNameBoxStyle}" Loaded="PTabLoadHandle" KeyDown="PTabKeyHandle" LostKeyboardFocus="PTabLeaveHandle" />
                        <Border Grid.Column="2" Style="{StaticResource pTabCloseStyle}" MouseLeftButtonDown="PTabCloseHandle">
                            <Canvas Width="20" Height="20"><Line X1="6.5" Y1="6.5" X2="13.5" Y2="13.5" Stroke="#4F5C6F" StrokeThickness="1.15"/><Line X1="13.5" Y1="6.5" X2="6.5" Y2="13.5" Stroke="#4F5C6F" StrokeThickness="1.15"/></Canvas>
                        </Border>
                    </Grid>
                </Border>
                <Canvas Width="1" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0" IsHitTestVisible="False">
                    <Canvas.Style><Style TargetType="Canvas"><Style.Triggers><DataTrigger Binding="{Binding PTabSeparatorState}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Canvas.Style>
                    <Line X1="0.5" Y1="0" X2="0.5" Y2="16" Stroke="#C9D6E5" StrokeThickness="1"/>
                </Canvas>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="pVerticalTabTemplate" DataType="{x:Type pControlBar:PTabRecord}">
            <Grid Margin="8,4,0,0">
                <Border Style="{StaticResource pTabFrameVerticalStyle}" MouseEnter="PTabEnterHandle" MouseLeave="PTabLeaveHandle" MouseLeftButtonDown="PTabPressHandle" MouseMove="PTabMoveHandle" MouseLeftButtonUp="PTabReleaseHandle">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Image Width="17" Height="17" Source="{Binding PTabIconSource}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource pTabNameTextStyle}" Text="{Binding PTabTitle}" Tag="pTabNameText" />
                        <TextBox Grid.Column="1" Style="{StaticResource pTabNameBoxStyle}" Loaded="PTabLoadHandle" KeyDown="PTabKeyHandle" LostKeyboardFocus="PTabLeaveHandle" />
                        <Border Grid.Column="2" Style="{StaticResource pTabCloseStyle}" MouseLeftButtonDown="PTabCloseHandle">
                            <Canvas Width="20" Height="20"><Line X1="6.5" Y1="6.5" X2="13.5" Y2="13.5" Stroke="#4F5C6F" StrokeThickness="1.15"/><Line X1="13.5" Y1="6.5" X2="6.5" Y2="13.5" Stroke="#4F5C6F" StrokeThickness="1.15"/></Canvas>
                        </Border>
                    </Grid>
                </Border>
                <Border Height="1" Background="#C9D6E5" VerticalAlignment="Bottom" Margin="10,0,10,-4" IsHitTestVisible="False">
                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding PTabSeparatorState}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Border x:Name="pTabRoot" Background="Transparent" BorderBrush="#C9D6E5" BorderThickness="0">
        <ScrollViewer x:Name="pTabViewport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="pTabStack" Orientation="Horizontal">
                <ItemsControl x:Name="pTabItemsControl" ItemsSource="{Binding PStripRecords}" ItemTemplate="{StaticResource pHorizontalTabTemplate}" ItemsPanel="{StaticResource pHorizontalItemsPanel}" />
                <Button x:Name="pTabAddButton" Style="{StaticResource pTabAddHorizontalStyle}" Content="+" Click="PTabMenuHandle" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
