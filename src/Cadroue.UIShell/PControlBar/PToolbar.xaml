<UserControl x:Class="Cadroue.UIShell.PControlBar.PToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="56" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Background="#EAF2FC">
        <Border VerticalAlignment="Bottom" Height="1" Background="#C9D6E5" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition x:Name="pRailHeaderColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="#EAF2FC" Cursor="Hand" MouseLeftButtonDown="PLogoClickHandle">
                <Image Source="/PAssets/PProgram/PProgramIcon.png" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,13,0,0" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
            </Grid>
            <Border Grid.Column="1" Background="#EAF2FC" />
            <Grid x:Name="pTitleCenter" Grid.Column="2">
                <ContentControl x:Name="pTabHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <ContentControl x:Name="pSceneHost" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
            </Grid>
            <Border x:Name="pRailHeaderDivider" Grid.Column="2" Width="1" HorizontalAlignment="Left" Background="#C9D6E5" Visibility="Collapsed" Panel.ZIndex="2" />
            <Border Grid.Column="3" Background="#EAF2FC" CornerRadius="9" ClipToBounds="True">
                <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Top">
                    <Button x:Name="pChromeMinimizeButton" Click="PChromeMinimizeHandle"><Canvas Width="18" Height="16"><Line X1="2" Y1="12" X2="14" Y2="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" /></Canvas></Button>
                    <Button x:Name="pChromeMaximizeButton" Click="PChromeMaximizeHandle"><Canvas Width="18" Height="16"><Rectangle Width="12" Height="12" Canvas.Left="2" Canvas.Top="2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent" /></Canvas></Button>
                    <Button x:Name="pChromeCloseButton" Click="PChromeCloseHandle"><Canvas Width="18" Height="16"><Line X1="2.5" Y1="2.5" X2="13.5" Y2="13.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25"/><Line X1="13.5" Y1="2.5" X2="2.5" Y2="13.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25"/></Canvas></Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
