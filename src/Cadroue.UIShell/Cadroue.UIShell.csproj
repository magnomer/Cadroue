<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Cadroue</AssemblyName>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cadroue.Core\Cadroue.Core.csproj" />
    <ProjectReference Include="..\Cadroue.ShellEngine\Cadroue.ShellEngine.csproj" />
    <ProjectReference Include="..\Cadroue.Media\Cadroue.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="PAssets\PTabs\*.png" />
    <Resource Include="PAssets\PTabs\*.svg" />
    <Resource Include="PAssets\PCompass\PAction*.png" />
    <Resource Include="PAssets\PCompass\*.svg" />
    <Resource Include="PAssets\PPanels\*.svg" />
    <Resource Include="PAssets\PMenus\*.png" />
    <Resource Include="PAssets\PMenus\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <None Update="PAssets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Flyleaf.FFmpeg.Bindings" Version="8.1.0" />
    <PackageReference Include="FlyleafLib" Version="3.10.4" />
    <PackageReference Include="FlyleafLib.Controls.WPF" Version="1.6.4" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
  </ItemGroup>
</Project>
