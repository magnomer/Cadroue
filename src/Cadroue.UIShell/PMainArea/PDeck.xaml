<UserControl x:Class="Cadroue.UIShell.PMainArea.PDeck"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Border Background="#FFFFFF"
            BorderBrush="#D9DEE7"
            BorderThickness="0"
            Padding="0,10,0,0"
            ClipToBounds="True">
        <Grid x:Name="pDeckGrid" ClipToBounds="True" />
    </Border>
</UserControl>
