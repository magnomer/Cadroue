<Application x:Class="Cadroue.UIVeneer.PProgram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PHouse/PCheckbox.xaml" />
                <ResourceDictionary Source="PHouse/PSlider.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <sys:String x:Key="PIconRoot">pack://application:,,,/Cadroue.UIVeneer;component/</sys:String>
        </ResourceDictionary>
    </Application.Resources>
</Application>
