<Application x:Class="Cadroue.UIVeneer.PProgram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:veneer="clr-namespace:Cadroue.UIVeneer"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Kit/PCheckbox.xaml" />
                <ResourceDictionary Source="Kit/PSlider.xaml" />
                <ResourceDictionary Source="Kit/PRadio.xaml" />
                <ResourceDictionary Source="Kit/PScrollbar.xaml" />
                <ResourceDictionary Source="Kit/Ghost/PGhost.xaml" />
                <ResourceDictionary Source="Kit/Dropdown/PDropdown.xaml" />
                <ResourceDictionary Source="Kit/PTextbox.xaml" />
                <ResourceDictionary Source="Kit/Token/PToken.xaml" />
                <ResourceDictionary Source="Kit/Picker/PPicker.xaml" />
                <ResourceDictionary Source="Kit/Button/PButton.xaml" />
                <ResourceDictionary Source="Kit/Menu/PMenu.xaml" />
                <ResourceDictionary Source="Porch/Strip/PStrip.xaml" />
                <ResourceDictionary Source="Kit/Panel/PPanel.xaml" />
                <ResourceDictionary Source="Kit/PTool.xaml" />
                <ResourceDictionary Source="Wing/Inspector/PGamma.xaml" />
                <ResourceDictionary Source="Wing/Inspector/PExposure.xaml" />
                <ResourceDictionary Source="Wing/Inspector/Curve/PCurve.xaml" />
                <ResourceDictionary Source="Wing/Inspector/Curve/PCurveCanvas.xaml" />
                <ResourceDictionary Source="Wing/Inspector/Whitebalance/PWhitebalance.xaml" />
                <ResourceDictionary Source="Wing/Inspector/Whitebalance/PWhitebalanceNeutral.xaml" />
                <ResourceDictionary Source="Wing/Inspector/Whitebalance/PWhitebalanceWheel.xaml" />
                <ResourceDictionary Source="Wing/Inspector/PVolume.xaml" />
                <ResourceDictionary Source="Wing/Inspector/PLoudness.xaml" />
                <ResourceDictionary Source="Wing/Inspector/PNoise.xaml" />
                <ResourceDictionary Source="Wing/Inspector/PFilter.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <sys:String x:Key="PIconRoot">pack://application:,,,/Cadroue.UIVeneer;component/</sys:String>
            <veneer:PSource x:Key="PSource" x:Shared="False" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
