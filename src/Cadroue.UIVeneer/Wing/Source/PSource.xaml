<UserControl x:Class="Cadroue.UIVeneer.PSource"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="38">
    <Grid Margin="16,6,16,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                MinHeight="38"
                Padding="14,0,14,0"
                VerticalAlignment="Stretch"
                BorderBrush="#D9DEE7"
                BorderThickness="1"
                Background="White"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Width="20"
                       Height="20"
                       Margin="0,0,10,0"
                       Stretch="Uniform">
                    <Image.Source>
                        <CroppedBitmap Source="/PAsset/P32/PPanel/Video.png" SourceRect="3,6,26,20" />
                    </Image.Source>
                </Image>
                <TextBox x:Name="pSourcePath"
                         Grid.Column="1"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Foreground="#111827"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         FocusVisualStyle="{x:Null}" />
                <TextBlock x:Name="pSourcePlaceholder"
                           Grid.Column="1"
                           FontSize="11"
                           Foreground="#9CA3AF"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>
        <Button x:Name="pSourceBrowse" Grid.Column="2" Style="{StaticResource PButtonSource}">
            <Image Width="18"
                   Height="18"
                   Stretch="Uniform">
                <Image.Source>
                    <CroppedBitmap Source="/PAsset/P32/PPanel/Folder.png" SourceRect="3,8,25,18" />
                </Image.Source>
            </Image>
        </Button>
    </Grid>
</UserControl>
