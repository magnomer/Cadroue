<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel x:Key="PSensorBody"
                x:Shared="False"
                Margin="12"
                Visibility="Collapsed">
        <CheckBox x:Name="PSensorEnablement"
                  FontSize="12"
                  FontFamily="{StaticResource PToolFont}"
                  Foreground="{StaticResource PToolText}"
                  VerticalContentAlignment="Center" />
        <Border Height="1"
                Background="{StaticResource PPanelLine}"
                Margin="0,12" />
        <StackPanel>
            <Grid x:Name="PSensorMetrics" Height="34" Margin="0,0,0,8">
                <TextBlock Width="80"
                           FontSize="12"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />
                <Border BorderBrush="{StaticResource PRadioLine}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="White"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton FontSize="12"
                                     FontFamily="{StaticResource PToolFont}"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource PRadioFirst}" />
                        <RadioButton FontSize="12"
                                     FontFamily="{StaticResource PToolFont}"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource PRadioLast}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="PSensorChoices" Height="34" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="80"
                               FontSize="12"
                               FontFamily="{StaticResource PToolFont}"
                               Foreground="{StaticResource PToolText}"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="PSensorProfiles"
                              Width="140"
                              Height="26"
                              HorizontalAlignment="Left"
                              FontSize="12"
                              FontFamily="{StaticResource PToolFont}" />
                </StackPanel>
            </Grid>
            <Grid x:Name="PSensorSpeeds" Height="34" Margin="0,0,0,8">
                <TextBlock Width="80"
                           FontSize="12"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />
                <Border BorderBrush="{StaticResource PRadioLine}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="White"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton FontSize="12"
                                     FontFamily="{StaticResource PToolFont}"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource PRadioFirst}" />
                        <RadioButton FontSize="12"
                                     FontFamily="{StaticResource PToolFont}"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource PRadioMiddle}" />
                        <RadioButton FontSize="12"
                                     FontFamily="{StaticResource PToolFont}"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource PRadioLast}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="PSensorThreshold" Height="34" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Width="80"
                           FontSize="12"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center" />
                <Slider Grid.Column="1" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           FontSize="11"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolMuted}"
                           VerticalAlignment="Center"
                           Margin="8,0" />
                <TextBox Grid.Column="3"
                         Width="68"
                         Height="26"
                         FontSize="12"
                         FontFamily="{StaticResource PToolFont}"
                         TextAlignment="Center"
                         Padding="4,0"
                         VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="PSensorSpan" Height="34" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Width="80"
                           FontSize="12"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center" />
                <Slider Grid.Column="1" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           FontSize="11"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolMuted}"
                           VerticalAlignment="Center"
                           Margin="8,0" />
                <TextBox Grid.Column="3"
                         Width="68"
                         Height="26"
                         FontSize="12"
                         FontFamily="{StaticResource PToolFont}"
                         TextAlignment="Center"
                         Padding="4,0"
                         VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="PSensorMinimum" Height="34" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Width="80"
                           FontSize="12"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center" />
                <Slider Grid.Column="1" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           FontSize="11"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolMuted}"
                           VerticalAlignment="Center"
                           Margin="8,0" />
                <TextBox Grid.Column="3"
                         Width="68"
                         Height="26"
                         FontSize="12"
                         FontFamily="{StaticResource PToolFont}"
                         TextAlignment="Center"
                         Padding="4,0"
                         VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="PSensorModes" Height="34" Margin="0,0,0,8">
                <TextBlock Width="80"
                           FontSize="12"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />
                <Border BorderBrush="{StaticResource PRadioLine}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="White"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton FontSize="12"
                                     FontFamily="{StaticResource PToolFont}"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource PRadioFirst}" />
                        <RadioButton FontSize="12"
                                     FontFamily="{StaticResource PToolFont}"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource PRadioLast}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </StackPanel>
</ResourceDictionary>
