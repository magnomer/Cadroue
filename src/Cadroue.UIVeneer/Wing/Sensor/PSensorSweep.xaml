<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PSensorProgress" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Foreground" Value="{x:Null}" />
        <Setter Property="Background" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="4"
                            Background="#E4E9F0"
                            ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="4"
                                    Background="#4C86F7" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Border x:Key="PSensorSweepBody"
            x:Shared="False"
            Padding="12,6,12,8"
            BorderBrush="{StaticResource PPanelLine}"
            BorderThickness="0,1,0,0"
            Background="White"
            Visibility="Collapsed">
        <StackPanel>
            <ProgressBar x:Name="PSensorProgress"
                         Style="{StaticResource PSensorProgress}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="PSensorRunPersistent"
                          FontSize="12"
                          FontFamily="{StaticResource PToolFont}"
                          Foreground="{StaticResource PToolText}"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Center" />
                <Button x:Name="PSensorRunButton"
                        Grid.Column="1"
                        Height="28"
                        MinWidth="90"
                        FontSize="12"
                        FontFamily="{StaticResource PToolFont}"
                        VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </Border>
</ResourceDictionary>
