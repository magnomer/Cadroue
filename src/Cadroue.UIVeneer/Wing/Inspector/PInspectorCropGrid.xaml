<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../Kit/PTool.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Grid x:Key="PInspectorGridBody" x:Shared="False" Margin="0,14,0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Margin="0,3">
            <TextBlock x:Name="PInspectorTopLabel" FontSize="11" FontFamily="{StaticResource PToolFont}"
                       Foreground="{StaticResource PToolMuted}" HorizontalAlignment="Center" Margin="0,0,0,3" />
            <TextBox x:Name="PInspectorInsetTop" Text="0" Width="68" Height="26" FontSize="12"
                     FontFamily="{StaticResource PToolFont}" TextAlignment="Center" Padding="4,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" Margin="0,3">
            <TextBlock x:Name="PInspectorLeftLabel" FontSize="11" FontFamily="{StaticResource PToolFont}"
                       Foreground="{StaticResource PToolMuted}" HorizontalAlignment="Center" Margin="0,0,0,3" />
            <TextBox x:Name="PInspectorInsetLeft" Text="0" Width="68" Height="26" FontSize="12"
                     FontFamily="{StaticResource PToolFont}" TextAlignment="Center" Padding="4,0" />
        </StackPanel>
        <Border x:Name="PInspectorResolutionBody" Grid.Row="1" Grid.Column="1"
                MinWidth="84" Height="26" Padding="7,0"
                Background="#FFF7F9FC" BorderBrush="{DynamicResource PPanelLine}"
                BorderThickness="1" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="3">
            <TextBlock x:Name="PInspectorResolution" Text="—" FontSize="11"
                       FontFamily="{StaticResource PToolFont}" Foreground="{StaticResource PToolMuted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" Margin="0,3">
            <TextBlock x:Name="PInspectorRightLabel" FontSize="11" FontFamily="{StaticResource PToolFont}"
                       Foreground="{StaticResource PToolMuted}" HorizontalAlignment="Center" Margin="0,0,0,3" />
            <TextBox x:Name="PInspectorInsetRight" Text="0" Width="68" Height="26" FontSize="12"
                     FontFamily="{StaticResource PToolFont}" TextAlignment="Center" Padding="4,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" Margin="0,3">
            <TextBlock x:Name="PInspectorBottomLabel" FontSize="11" FontFamily="{StaticResource PToolFont}"
                       Foreground="{StaticResource PToolMuted}" HorizontalAlignment="Center" Margin="0,0,0,3" />
            <TextBox x:Name="PInspectorInsetBottom" Text="0" Width="68" Height="26" FontSize="12"
                     FontFamily="{StaticResource PToolFont}" TextAlignment="Center" Padding="4,0" />
        </StackPanel>
        <Button x:Name="PInspectorResetButton" Grid.Row="2" Grid.Column="2" Height="26" MinWidth="64"
                Padding="8,0" FontSize="11" FontFamily="{StaticResource PToolFont}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="3" />
    </Grid>
</ResourceDictionary>
