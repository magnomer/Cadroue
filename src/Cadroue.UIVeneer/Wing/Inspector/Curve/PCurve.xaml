<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../Kit/PTool.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <StackPanel x:Key="PCurve"
                x:Shared="False"
                Margin="12,12,12,12"
                Visibility="Collapsed">
        <CheckBox x:Name="PCurveActive"
                  FontSize="12"
                  FontFamily="{StaticResource PToolFont}"
                  Foreground="{StaticResource PToolText}"
                  VerticalContentAlignment="Center" />
        <Border Height="1"
                Background="{StaticResource PToolLine}"
                Margin="0,12,0,12" />
        <StackPanel x:Name="PCurveStack">
            <StackPanel Orientation="Horizontal"
                        Height="34"
                        Margin="0,0,0,8">
                <TextBlock x:Name="PCurveChoiceLabel"
                           Width="80"
                           FontSize="12"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="PCurveChoice"
                          Height="26"
                          Width="140"
                          HorizontalAlignment="Left"
                          FontSize="12"
                          FontFamily="{StaticResource PToolFont}" />
            </StackPanel>
            <Border x:Name="PCurveCanvasHost"
                    Height="160"
                    Margin="0,0,0,8"
                    BorderBrush="{StaticResource PToolLine}"
                    BorderThickness="1"
                    Background="#F6F8FA" />
            <StackPanel Orientation="Horizontal"
                        Height="34"
                        Margin="0,0,0,8">
                <TextBlock x:Name="PCurveInputLabel"
                           Width="80"
                           FontSize="12"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center" />
                <TextBox x:Name="PCurveInput"
                         Width="68"
                         Height="26"
                         FontSize="12"
                         FontFamily="{StaticResource PToolFont}"
                         TextAlignment="Center"
                         Padding="4,0,4,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Height="34"
                        Margin="0,0,0,8">
                <TextBlock x:Name="PCurveOutputLabel"
                           Width="80"
                           FontSize="12"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center" />
                <TextBox x:Name="PCurveOutput"
                         Width="68"
                         Height="26"
                         FontSize="12"
                         FontFamily="{StaticResource PToolFont}"
                         TextAlignment="Center"
                         Padding="4,0,4,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,4,0,0">
                <Button x:Name="PCurvePointButton"
                        Height="28"
                        MinWidth="64"
                        Padding="8,0,8,0"
                        Margin="0,0,6,0"
                        FontSize="11"
                        FontFamily="{StaticResource PToolFont}" />
                <Button x:Name="PCurveChannelButton"
                        Height="28"
                        MinWidth="64"
                        Padding="8,0,8,0"
                        Margin="0,0,6,0"
                        FontSize="11"
                        FontFamily="{StaticResource PToolFont}" />
                <Button x:Name="PCurveResetButton"
                        Height="28"
                        MinWidth="64"
                        Padding="8,0,8,0"
                        FontSize="11"
                        FontFamily="{StaticResource PToolFont}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>

    <CheckBox x:Key="PCurvePersistent"
              x:Shared="False"
              FontSize="12"
              FontFamily="{StaticResource PToolFont}"
              Foreground="{StaticResource PToolText}"
              VerticalContentAlignment="Center" />
</ResourceDictionary>
