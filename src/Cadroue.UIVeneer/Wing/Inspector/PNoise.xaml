<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../Kit/PTool.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <StackPanel x:Key="PNoise"
                x:Shared="False"
                Margin="12,12,12,12"
                Visibility="Collapsed">
        <CheckBox x:Name="PNoiseActive"
                  FontSize="12"
                  FontFamily="{StaticResource PToolFont}"
                  Foreground="{StaticResource PToolText}"
                  VerticalContentAlignment="Center" />
        <Border Height="1"
                Background="{StaticResource PToolLine}"
                Margin="0,12,0,12" />
        <StackPanel x:Name="PNoiseStack">
            <Grid Height="34" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="12"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="PNoisePreset"
                          Grid.Column="1"
                          Height="26"
                          Width="140"
                          HorizontalAlignment="Left"
                          FontSize="12"
                          FontFamily="{StaticResource PToolFont}" />
            </Grid>
            <StackPanel x:Name="PNoiseRows">
                <Grid Height="34" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="12"
                               FontFamily="{StaticResource PToolFont}"
                               Foreground="{StaticResource PToolText}"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               FontSize="11"
                               FontFamily="{StaticResource PToolFont}"
                               Foreground="{StaticResource PToolMuted}"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0" />
                    <TextBox Grid.Column="3"
                             Width="68"
                             Height="26"
                             FontSize="12"
                             FontFamily="{StaticResource PToolFont}"
                             TextAlignment="Center"
                             Padding="4,0,4,0"
                             VerticalAlignment="Center" />
                </Grid>
                <Grid Height="34" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="12"
                               FontFamily="{StaticResource PToolFont}"
                               Foreground="{StaticResource PToolText}"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               FontSize="11"
                               FontFamily="{StaticResource PToolFont}"
                               Foreground="{StaticResource PToolMuted}"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0" />
                    <TextBox Grid.Column="3"
                             Width="68"
                             Height="26"
                             FontSize="12"
                             FontFamily="{StaticResource PToolFont}"
                             TextAlignment="Center"
                             Padding="4,0,4,0"
                             VerticalAlignment="Center" />
                </Grid>
                <Grid Height="34" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="12"
                               FontFamily="{StaticResource PToolFont}"
                               Foreground="{StaticResource PToolText}"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               FontSize="11"
                               FontFamily="{StaticResource PToolFont}"
                               Foreground="{StaticResource PToolMuted}"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0" />
                    <TextBox Grid.Column="3"
                             Width="68"
                             Height="26"
                             FontSize="12"
                             FontFamily="{StaticResource PToolFont}"
                             TextAlignment="Center"
                             Padding="4,0,4,0"
                             VerticalAlignment="Center" />
                </Grid>
                <Grid Height="34" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="12"
                               FontFamily="{StaticResource PToolFont}"
                               Foreground="{StaticResource PToolText}"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               FontSize="11"
                               FontFamily="{StaticResource PToolFont}"
                               Foreground="{StaticResource PToolMuted}"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0" />
                    <TextBox Grid.Column="3"
                             Width="68"
                             Height="26"
                             FontSize="12"
                             FontFamily="{StaticResource PToolFont}"
                             TextAlignment="Center"
                             Padding="4,0,4,0"
                             VerticalAlignment="Center" />
                </Grid>
                <Grid Height="34" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="12"
                               FontFamily="{StaticResource PToolFont}"
                               Foreground="{StaticResource PToolText}"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               FontSize="11"
                               FontFamily="{StaticResource PToolFont}"
                               Foreground="{StaticResource PToolMuted}"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0" />
                    <TextBox Grid.Column="3"
                             Width="68"
                             Height="26"
                             FontSize="12"
                             FontFamily="{StaticResource PToolFont}"
                             TextAlignment="Center"
                             Padding="4,0,4,0"
                             VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
            <Grid Height="34" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="12"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="PNoiseType"
                          Grid.Column="1"
                          Height="26"
                          Width="120"
                          HorizontalAlignment="Left"
                          FontSize="12"
                          FontFamily="{StaticResource PToolFont}" />
            </Grid>
            <CheckBox x:Name="PNoiseTrack"
                      FontSize="12"
                      FontFamily="{StaticResource PToolFont}"
                      Foreground="{StaticResource PToolText}"
                      VerticalContentAlignment="Center"
                      Margin="0,8,0,0" />
        </StackPanel>
    </StackPanel>

    <CheckBox x:Key="PNoisePersistent"
              x:Shared="False"
              FontSize="12"
              FontFamily="{StaticResource PToolFont}"
              Foreground="{StaticResource PToolText}"
              VerticalContentAlignment="Center" />
</ResourceDictionary>
