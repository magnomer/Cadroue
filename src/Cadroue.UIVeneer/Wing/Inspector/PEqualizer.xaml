<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../Kit/PTool.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="pEqualizerBand">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Height="34" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PEqualizerFrequency"
                         Width="56"
                         Height="26"
                         FontSize="12"
                         FontFamily="{StaticResource PToolFont}"
                         TextAlignment="Center"
                         Padding="4,0,4,0"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="Hz"
                           FontSize="11"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolMuted}"
                           VerticalAlignment="Center"
                           Margin="6,0,6,0" />
                <Slider x:Name="PEqualizerSlider"
                        Grid.Column="2"
                        VerticalAlignment="Center" />
                <TextBox x:Name="PEqualizerValue"
                         Grid.Column="3"
                         Width="34"
                         Height="26"
                         FontSize="12"
                         FontFamily="{StaticResource PToolFont}"
                         TextAlignment="Center"
                         Padding="4,0,4,0"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="4"
                           Text="dB"
                           FontSize="11"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolMuted}"
                           VerticalAlignment="Center"
                           Margin="6,0,6,0" />
            </Grid>
            <Button x:Name="PEqualizerRemoval"
                    Grid.Column="1"
                    Width="26"
                    Height="26"
                    Margin="6,0,0,8"
                    VerticalAlignment="Center">
                <Image Width="16"
                       Height="16"
                       Stretch="Uniform" />
            </Button>
        </Grid>
    </DataTemplate>

    <StackPanel x:Key="PEqualizer"
                x:Shared="False"
                Margin="12,12,12,12"
                Visibility="Collapsed">
        <CheckBox x:Name="PEqualizerActive"
                  FontSize="12"
                  FontFamily="{StaticResource PToolFont}"
                  Foreground="{StaticResource PToolText}"
                  VerticalContentAlignment="Center" />
        <Border Height="1"
                Background="{StaticResource PToolLine}"
                Margin="0,12,0,12" />
        <StackPanel x:Name="PEqualizerStack">
            <Grid Height="34" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="12"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="PEqualizerPreset"
                          Grid.Column="1"
                          Height="26"
                          Width="140"
                          HorizontalAlignment="Left"
                          FontSize="12"
                          FontFamily="{StaticResource PToolFont}" />
            </Grid>
            <StackPanel x:Name="PEqualizerRows" />
            <Button x:Name="PEqualizerInsertion"
                    Width="28"
                    Height="26"
                    HorizontalAlignment="Left">
                <Image Width="20"
                       Height="20"
                       Stretch="Uniform" />
            </Button>
        </StackPanel>
    </StackPanel>

    <CheckBox x:Key="PEqualizerPersistent"
              x:Shared="False"
              FontSize="12"
              FontFamily="{StaticResource PToolFont}"
              Foreground="{StaticResource PToolText}"
              VerticalContentAlignment="Center" />
</ResourceDictionary>
