<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel x:Key="PBlankBody"
                x:Shared="False"
                Margin="12"
                Visibility="Collapsed">
        <CheckBox x:Name="PBlankSwitch"
                  FontSize="12"
                  FontFamily="{StaticResource PToolFont}"
                  Foreground="{StaticResource PToolText}"
                  VerticalContentAlignment="Center" />
        <Border Height="1"
                Background="{StaticResource PPanelLine}"
                Margin="0,12" />
        <StackPanel x:Name="PBlankStack">
            <Border BorderBrush="{StaticResource PRadioLine}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White"
                    SnapsToDevicePixels="True"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="PBlankBlack"
                                 GroupName="PBlankType"
                                 FontSize="12"
                                 FontFamily="{StaticResource PToolFont}"
                                 VerticalContentAlignment="Center"
                                 Style="{StaticResource PRadioFirst}" />
                    <RadioButton x:Name="PBlankColor"
                                 GroupName="PBlankType"
                                 FontSize="12"
                                 FontFamily="{StaticResource PToolFont}"
                                 VerticalContentAlignment="Center"
                                 Style="{StaticResource PRadioLast}" />
                </StackPanel>
            </Border>
            <StackPanel x:Name="PBlankColorArea">
                <Grid Height="34" Margin="0,0,0,8">
                    <TextBlock Width="80"
                               FontSize="12"
                               FontFamily="{StaticResource PToolFont}"
                               Foreground="{StaticResource PToolText}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left" />
                    <ToggleButton x:Name="PBlankPicker"
                                  Width="32"
                                  Height="32"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"
                                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                        <Image x:Name="PBlankPickerIcon"
                               Width="18"
                               Height="18"
                               Stretch="Uniform" />
                    </ToggleButton>
                </Grid>
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Canvas x:Name="PBlankWheelCanvas"
                            Width="120"
                            Height="120"
                            Background="Transparent"
                            Cursor="Cross">
                        <Image x:Name="PBlankWheelImage"
                               Width="120"
                               Height="120"
                               IsHitTestVisible="False" />
                        <Ellipse x:Name="PBlankWheelDot"
                                 Width="11"
                                 Height="11"
                                 Stroke="White"
                                 StrokeThickness="2"
                                 Fill="Transparent"
                                 IsHitTestVisible="False"
                                 Visibility="Collapsed" />
                    </Canvas>
                    <Slider x:Name="PBlankBrightnessSlider"
                            Width="120"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,6,0,0" />
                    <TextBox x:Name="PBlankBrightnessValue"
                             Width="68"
                             Height="26"
                             FontSize="12"
                             FontFamily="{StaticResource PToolFont}"
                             TextAlignment="Center"
                             Padding="4,0"
                             Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
            <Grid Height="34" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PBlankToleranceLabel"
                           Width="80"
                           FontSize="12"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center" />
                <Slider x:Name="PBlankToleranceSlider"
                        Grid.Column="1"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           FontSize="11"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolMuted}"
                           VerticalAlignment="Center"
                           Margin="8,0" />
                <TextBox x:Name="PBlankToleranceValue"
                         Grid.Column="3"
                         Width="68"
                         Height="26"
                         FontSize="12"
                         FontFamily="{StaticResource PToolFont}"
                         TextAlignment="Center"
                         Padding="4,0"
                         VerticalAlignment="Center" />
            </Grid>
            <Grid Height="34" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PBlankCoverageLabel"
                           Width="80"
                           FontSize="12"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center" />
                <Slider x:Name="PBlankCoverageSlider"
                        Grid.Column="1"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           FontSize="11"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolMuted}"
                           VerticalAlignment="Center"
                           Margin="8,0" />
                <TextBox x:Name="PBlankCoverageValue"
                         Grid.Column="3"
                         Width="68"
                         Height="26"
                         FontSize="12"
                         FontFamily="{StaticResource PToolFont}"
                         TextAlignment="Center"
                         Padding="4,0"
                         VerticalAlignment="Center" />
            </Grid>
            <Grid Height="34" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PBlankMinimumLabel"
                           Width="80"
                           FontSize="12"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center" />
                <Slider x:Name="PBlankMinimumSlider"
                        Grid.Column="1"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="s"
                           FontSize="11"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolMuted}"
                           VerticalAlignment="Center"
                           Margin="8,0" />
                <TextBox x:Name="PBlankMinimumValue"
                         Grid.Column="3"
                         Width="68"
                         Height="26"
                         FontSize="12"
                         FontFamily="{StaticResource PToolFont}"
                         TextAlignment="Center"
                         Padding="4,0"
                         VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </StackPanel>
</ResourceDictionary>
