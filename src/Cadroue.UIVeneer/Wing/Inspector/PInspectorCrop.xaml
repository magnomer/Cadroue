<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../Kit/PTool.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <StackPanel x:Key="PInspectorCropBody" x:Shared="False"
                Margin="12" Visibility="Collapsed">
        <CheckBox x:Name="PInspectorApplyBox" FontSize="12"
                  FontFamily="{StaticResource PToolFont}" Foreground="{StaticResource PToolText}"
                  VerticalContentAlignment="Center" />
        <Border Height="1" Background="{DynamicResource PPanelLine}" Margin="0,12" />
        <StackPanel x:Name="PInspectorCropStack">
            <StackPanel Orientation="Horizontal" Height="34" Margin="0,0,0,8">
                <TextBlock x:Name="PInspectorToolLabel" Width="80" FontSize="12"
                           FontFamily="{StaticResource PToolFont}" Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center" />
                <ToggleButton x:Name="PInspectorCropTool" Width="32" Height="32"
                              VerticalAlignment="Center">
                    <Image x:Name="PInspectorToolIcon" Width="18" Height="18" Stretch="Uniform" />
                </ToggleButton>
            </StackPanel>
            <ContentPresenter x:Name="PInspectorCropOrientation" />
            <ContentPresenter x:Name="PInspectorCropGrid" />
            <ContentPresenter x:Name="PInspectorCropRatio" />
        </StackPanel>
    </StackPanel>

    <CheckBox x:Key="PInspectorCropPersistent" x:Shared="False" FontSize="12"
              FontFamily="{StaticResource PToolFont}" Foreground="{StaticResource PToolText}"
              VerticalContentAlignment="Center" />
</ResourceDictionary>
