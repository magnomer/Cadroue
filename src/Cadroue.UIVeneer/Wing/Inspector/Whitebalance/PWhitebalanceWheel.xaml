<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel x:Key="PWhitebalanceWheel"
                x:Shared="False"
                HorizontalAlignment="Center"
                Margin="0,0,0,8">
        <Canvas x:Name="PWhitebalanceWheelCanvas"
                Width="120"
                Height="120"
                Background="Transparent"
                Cursor="Cross">
            <Image x:Name="PWhitebalanceWheelImage"
                   Width="120"
                   Height="120"
                   IsHitTestVisible="False" />
            <Ellipse x:Name="PWhitebalanceWheelDot"
                     Width="11"
                     Height="11"
                     Stroke="White"
                     StrokeThickness="2"
                     Fill="Transparent"
                     IsHitTestVisible="False"
                     Visibility="Collapsed">
                <Ellipse.Effect>
                    <DropShadowEffect Color="Black"
                                      BlurRadius="2"
                                      ShadowDepth="0"
                                      Opacity="0.8" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>
        <Slider x:Name="PWhitebalanceWheelBrightness"
                Minimum="0"
                Maximum="1"
                Width="120"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,6,0,0" />
    </StackPanel>
</ResourceDictionary>
