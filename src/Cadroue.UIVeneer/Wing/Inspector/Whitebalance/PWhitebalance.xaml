<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../Kit/PTool.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <StackPanel x:Key="PWhitebalance"
                x:Shared="False"
                Margin="12,12,12,12"
                Visibility="Collapsed">
        <CheckBox x:Name="PWhitebalanceActive"
                  FontSize="12"
                  FontFamily="{StaticResource PToolFont}"
                  Foreground="{StaticResource PToolText}"
                  VerticalContentAlignment="Center" />
        <Border Height="1"
                Background="{StaticResource PToolLine}"
                Margin="0,12,0,12" />
        <StackPanel x:Name="PWhitebalanceStack">
            <StackPanel Orientation="Horizontal"
                        Height="34"
                        Margin="0,0,0,8">
                <TextBlock x:Name="PWhitebalanceMethodLabel"
                           Width="80"
                           FontSize="12"
                           FontFamily="{StaticResource PToolFont}"
                           Foreground="{StaticResource PToolText}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="PWhitebalanceMethod"
                          Height="26"
                          Width="140"
                          HorizontalAlignment="Left"
                          FontSize="12"
                          FontFamily="{StaticResource PToolFont}" />
            </StackPanel>
            <TextBlock x:Name="PWhitebalanceWarning"
                       Foreground="#647082"
                       TextWrapping="Wrap"
                       Margin="0,2,0,8" />
            <Button x:Name="PWhitebalanceResetButton"
                    Height="28"
                    MinWidth="64"
                    Padding="8,0,8,0"
                    FontSize="11"
                    FontFamily="{StaticResource PToolFont}"
                    HorizontalAlignment="Right" />
        </StackPanel>
    </StackPanel>

    <CheckBox x:Key="PWhitebalancePersistent"
              x:Shared="False"
              FontSize="12"
              FontFamily="{StaticResource PToolFont}"
              Foreground="{StaticResource PToolText}"
              VerticalContentAlignment="Center" />
</ResourceDictionary>
