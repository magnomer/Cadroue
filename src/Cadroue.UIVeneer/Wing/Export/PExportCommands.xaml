<ResourceDictionary x:Class="Cadroue.UIVeneer.PExportCommands"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="PExportCommands">
        <Grid Margin="10,4,10,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Button x:Name="PExportCreation"
                    Width="28"
                    Height="26"
                    Margin="0,0,2,0"
                    IsEnabled="True">
                <Image Width="20" Height="20" Stretch="Uniform" />
            </Button>
            <Button x:Name="PExportDeletion"
                    Width="28"
                    Height="26"
                    Margin="0,0,2,0"
                    IsEnabled="True">
                <Image Width="20" Height="20" Stretch="Uniform" />
            </Button>
        </StackPanel>
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="PExportConfiguration"
                    Width="28"
                    Height="26"
                    Margin="0,0,2,0"
                    IsEnabled="True">
                <Image Width="20" Height="20" Stretch="Uniform" />
            </Button>
            <Button x:Name="PExportOutbound"
                    Width="28"
                    Height="26"
                    Margin="0,0,2,0"
                    IsEnabled="True">
                <Image Width="20" Height="20" Stretch="Uniform" />
            </Button>
            <Button x:Name="PExportInbound"
                    Width="28"
                    Height="26"
                    Margin="0,0,2,0"
                    IsEnabled="True">
                <Image Width="20" Height="20" Stretch="Uniform" />
            </Button>
        </StackPanel>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
