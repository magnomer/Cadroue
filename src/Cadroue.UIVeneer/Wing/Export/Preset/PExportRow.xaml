<ResourceDictionary x:Class="Cadroue.UIVeneer.PExportRow"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="PExportRow">
    <Border Padding="12,5"
            Background="White"
            BorderBrush="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            HorizontalAlignment="Stretch">
        <Border.Resources>
            <TextBox x:Key="PExportEditor"
                     FontSize="12"
                     Foreground="#FF1D2A3D"
                     Background="Transparent"
                     BorderThickness="0,0,0,1"
                     BorderBrush="#FF4A90D9"
                     Padding="2,0,2,1"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"
                     FocusVisualStyle="{x:Null}" />
        </Border.Resources>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PExportLabel"
                           FontSize="12"
                           Foreground="#FF1D2A3D"
                           Padding="2,0,2,1"
                           VerticalAlignment="Center" />
                <Border x:Name="PExportBadge"
                        Background="#FFE8EEF6"
                        BorderBrush="#FFC8D4E2"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="5,1,5,2"
                        Margin="7,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock FontSize="10"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               Foreground="#FF4A5E75"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>
            <StackPanel x:Name="PExportActions"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="PExportAcceptance"
                        Width="22"
                        Height="20"
                        Margin="2,0,0,0">
                    <Image Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <Button x:Name="PExportReversion"
                        Width="22"
                        Height="20"
                        Margin="2,0,0,0">
                    <Image Width="16" Height="16" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
    </ControlTemplate>
</ResourceDictionary>
