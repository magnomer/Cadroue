<UserControl x:Class="Cadroue.UIVeneer.PExport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cadroue.UIVeneer"
             FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PExportTextBrush" Color="#FF1D2A3D" />
        <SolidColorBrush x:Key="PExportMutedBrush" Color="#FF626F83" />
    </UserControl.Resources>
    <Border Margin="8"
            BorderBrush="#FFD9DEE7"
            BorderThickness="1"
            Background="#FFF7F9FC"
            CornerRadius="10"
            SnapsToDevicePixels="True">
        <Border x:Name="PExportFrame"
                Background="#FFF7F9FC"
                CornerRadius="9"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Padding="12,10"
                        BorderBrush="#FFD9DEE7"
                        BorderThickness="0,0,0,1"
                        Background="#FFF3F5F8"
                        CornerRadius="9,9,0,0">
                    <TextBlock x:Name="PExportTitle"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FF26364A"
                               VerticalAlignment="Center" />
                </Border>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentControl x:Name="PExportBody" Grid.Row="0" />
                    <ContentControl x:Name="PExportCommands" Grid.Row="1" />
                    <Border Grid.Row="2"
                            Height="1"
                            Background="#FFD9DEE7"
                            Margin="0,8" />
                    <local:PExportSummary x:Name="PExportDigest" Grid.Row="3" />
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
