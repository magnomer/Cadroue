<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cadroue.UIDeportment\Cadroue.UIDeportment.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cadroue" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="PAsset\PTab\*.svg" />
    <Resource Include="PAsset\PCompass\*.svg" />
    <Resource Include="PAsset\PPanel\*.svg" />
    <Resource Include="PAsset\PMenu\*.svg" />
    <Resource Include="PAsset\PSDialog\*.svg" />
    <Resource Include="PAsset\P32\**\*.png" />
    <Resource Include="PAsset\P256\**\*.png" />
    <Resource Include="PAsset\PProgram\*.png" />
    <Resource Include="PAsset\PProgram\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\localization\*.json" Link="localization\%(Filename)%(Extension)" LogicalName="localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\localization\FFmpeg-error\*.json" Link="localization\FFmpeg-error\%(Filename)%(Extension)" LogicalName="localization.ffmpeg-error.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Flyleaf.FFmpeg.Bindings" Version="9.0.0" />
    <PackageReference Include="FlyleafLib" Version="3.11.0" />
    <PackageReference Include="FlyleafLib.Controls.WPF" Version="1.7.0" />
  </ItemGroup>
</Project>
