<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Visibility x:Key="PDropdownVisible">Visible</Visibility>
    <SolidColorBrush x:Key="PDropdownLine" Color="#D9DEE7" />
    <SolidColorBrush x:Key="PDropdownSoft" Color="#F7F9FC" />
    <SolidColorBrush x:Key="PDropdownText" Color="#1D2A3D" />
    <SolidColorBrush x:Key="PDropdownAccent" Color="#4C86F7" />
    <SolidColorBrush x:Key="PDropdownHighlight" Color="#ECF3FF" />
    <SolidColorBrush x:Key="PDropdownGlyph" Color="#26364A" />
    <SolidColorBrush x:Key="PDropdownHover" Color="#D3E1F2" />
    <SolidColorBrush x:Key="PDropdownPressed" Color="#C2D4EA" />

    <ControlTemplate x:Key="PDropdownChevron" TargetType="ToggleButton">
        <Border Background="{StaticResource PDropdownSoft}"
                BorderBrush="{StaticResource PDropdownLine}"
                BorderThickness="1,0,0,0"
                CornerRadius="0,10,10,0">
            <Path Data="M 3 4 L 6 7 L 9 4"
                  Stroke="{StaticResource PDropdownText}"
                  StrokeThickness="1.3"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Width="9"
                  Height="6"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="PDropdownBlank" TargetType="ToggleButton">
        <Border Background="Transparent" />
    </ControlTemplate>

    <Style x:Key="PDropdown" TargetType="ComboBox">
        <Setter Property="IsEditable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="PDropdownFrame"
                                Background="White"
                                BorderBrush="{StaticResource PDropdownLine}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <DockPanel>
                                <ToggleButton x:Name="PDropdownArrow"
                                              DockPanel.Dock="Right"
                                              Width="26"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              ClickMode="Press"
                                              Template="{StaticResource PDropdownChevron}" />
                                <Grid>
                                    <ToggleButton x:Name="PDropdownSurface"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="0"
                                                  ClickMode="Press"
                                                  Template="{StaticResource PDropdownBlank}" />
                                    <ContentPresenter x:Name="PDropdownFace"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Stretch"
                                                      Margin="14,0,10,0"
                                                      IsHitTestVisible="False" />
                                </Grid>
                            </DockPanel>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True">
                            <Border x:Name="PDropdownSheet"
                                    Background="White"
                                    BorderBrush="{StaticResource PDropdownLine}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="0,6,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" MaxHeight="260">
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PDropdownEditable" TargetType="ComboBox" BasedOn="{StaticResource PDropdown}">
        <Setter Property="IsEditable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="PDropdownFrame"
                                Background="White"
                                BorderBrush="{StaticResource PDropdownLine}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <DockPanel>
                                <ToggleButton x:Name="PDropdownArrow"
                                              DockPanel.Dock="Right"
                                              Width="26"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              ClickMode="Press"
                                              Template="{StaticResource PDropdownChevron}" />
                                <TextBox x:Name="PART_EditableTextBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource PDropdownText}"
                                         VerticalContentAlignment="Center"
                                         Padding="14,0,10,0"
                                         SelectionBrush="{StaticResource PDropdownAccent}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                         ScrollViewer.VerticalScrollBarVisibility="Hidden" />
                            </DockPanel>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True">
                            <Border x:Name="PDropdownSheet"
                                    Background="White"
                                    BorderBrush="{StaticResource PDropdownLine}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="0,6,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" MaxHeight="260">
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PDropdownRowButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource PDropdownGlyph}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PDropdownRowPlate" Background="Transparent" CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PDropdownRow" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="PDropdownRowFrame"
                            Background="Transparent"
                            CornerRadius="8"
                            Margin="4"
                            Padding="12,6,12,6">
                        <DockPanel>
                            <Path x:Name="PDropdownRowMark"
                                  DockPanel.Dock="Right"
                                  Data="M 3 7 L 6 10 L 11 4"
                                  Stroke="{StaticResource PDropdownAccent}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="12"
                                  Height="12"
                                  Stretch="Fill"
                                  Visibility="Collapsed"
                                  VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,8,0" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PDropdownRowAction" TargetType="ComboBoxItem" BasedOn="{StaticResource PDropdownRow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="PDropdownRowFrame"
                            Background="Transparent"
                            CornerRadius="8"
                            Margin="4"
                            Padding="12,6,2,6">
                        <DockPanel>
                            <Button x:Name="PDropdownRowButton"
                                    DockPanel.Dock="Right"
                                    Width="13"
                                    Height="13"
                                    VerticalAlignment="Center"
                                    Padding="0"
                                    Style="{StaticResource PDropdownRowButton}">
                                <Image x:Name="PDropdownRowMinus" Width="8" Height="8" Stretch="Uniform" />
                            </Button>
                            <Path x:Name="PDropdownRowMark"
                                  DockPanel.Dock="Right"
                                  Data="M 3 7 L 6 10 L 11 4"
                                  Stroke="{StaticResource PDropdownAccent}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="12"
                                  Height="12"
                                  Stretch="Fill"
                                  Visibility="Collapsed"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,8,0" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
