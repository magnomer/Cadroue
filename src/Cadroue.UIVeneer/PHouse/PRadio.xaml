<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:Double x:Key="PRadioFaded">0.45</sys:Double>
    <SolidColorBrush x:Key="PRadioLine" Color="#D9DEE7" />
    <SolidColorBrush x:Key="PRadioInk" Color="#1D2A3D" />
    <SolidColorBrush x:Key="PRadioAccent" Color="#4C86F7" />
    <SolidColorBrush x:Key="PRadioDeep" Color="#2F6BDB" />
    <SolidColorBrush x:Key="PRadioPlain" Color="#F0F3FA" />
    <SolidColorBrush x:Key="PRadioSoft" Color="#E6ECF6" />
    <SolidColorBrush x:Key="PRadioBright" Color="White" />

    <Border x:Key="PRadioSegment"
            x:Shared="False"
            BorderBrush="{StaticResource PRadioLine}"
            BorderThickness="1"
            CornerRadius="6"
            Background="White"
            SnapsToDevicePixels="True"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" />
    </Border>

    <Style x:Key="PRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource PRadioInk}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="PRadioSingle" TargetType="RadioButton" BasedOn="{StaticResource PRadio}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="PRadioSegmentBox"
                            Background="{StaticResource PRadioPlain}"
                            BorderBrush="{StaticResource PRadioLine}"
                            BorderThickness="0"
                            CornerRadius="5"
                            Padding="16,4,16,4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="PRadioSegmentLabel"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{StaticResource PRadioInk}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PRadioFirst" TargetType="RadioButton" BasedOn="{StaticResource PRadio}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="PRadioSegmentBox"
                            Background="{StaticResource PRadioPlain}"
                            BorderBrush="{StaticResource PRadioLine}"
                            BorderThickness="0"
                            CornerRadius="5,0,0,5"
                            Padding="16,4,16,4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="PRadioSegmentLabel"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{StaticResource PRadioInk}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PRadioMiddle" TargetType="RadioButton" BasedOn="{StaticResource PRadio}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="PRadioSegmentBox"
                            Background="{StaticResource PRadioPlain}"
                            BorderBrush="{StaticResource PRadioLine}"
                            BorderThickness="1,0,0,0"
                            CornerRadius="0"
                            Padding="16,4,16,4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="PRadioSegmentLabel"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{StaticResource PRadioInk}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PRadioLast" TargetType="RadioButton" BasedOn="{StaticResource PRadio}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="PRadioSegmentBox"
                            Background="{StaticResource PRadioPlain}"
                            BorderBrush="{StaticResource PRadioLine}"
                            BorderThickness="1,0,0,0"
                            CornerRadius="0,5,5,0"
                            Padding="16,4,16,4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="PRadioSegmentLabel"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{StaticResource PRadioInk}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
