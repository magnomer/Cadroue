<UserControl x:Class="Cadroue.UIVeneer.PWing.PInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="38">
    <UserControl.Resources>
        <DataTemplate x:Key="pInfoMuted">
            <TextBlock x:Name="pInfoCaption"
                       FontSize="11"
                       Foreground="#9CA3AF"
                       VerticalAlignment="Center" />
        </DataTemplate>
        <DataTemplate x:Key="pInfoText">
            <TextBlock x:Name="pInfoCaption"
                       FontSize="11"
                       Foreground="#4B5563"
                       VerticalAlignment="Center" />
        </DataTemplate>
        <DataTemplate x:Key="pInfoGrey">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7"
                         Height="7"
                         Fill="#9CA3AF"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="pInfoCaption"
                           FontSize="11"
                           Foreground="#4B5563"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="pInfoGood">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7"
                         Height="7"
                         Fill="#3A8BE0"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="pInfoCaption"
                           FontSize="11"
                           Foreground="#4B5563"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="pInfoBad">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7"
                         Height="7"
                         Fill="#E05353"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="pInfoCaption"
                           FontSize="11"
                           Foreground="#4B5563"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="pInfoSeparator">
            <Border Width="1"
                    Height="12"
                    Background="#E5E7EB"
                    Margin="14,0,14,0"
                    VerticalAlignment="Center" />
        </DataTemplate>
    </UserControl.Resources>
    <Border Padding="14,4,14,4"
            BorderBrush="#D9DEE7"
            BorderThickness="1"
            Background="White"
            CornerRadius="8">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Width="20"
                   Height="20"
                   Margin="0,0,10,0"
                   Stretch="Uniform">
                <Image.Source>
                    <CroppedBitmap Source="/PAsset/P32/PPanel/Info.png" SourceRect="4,4,24,24" />
                </Image.Source>
            </Image>
            <StackPanel x:Name="pInfoItems" Orientation="Horizontal" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
