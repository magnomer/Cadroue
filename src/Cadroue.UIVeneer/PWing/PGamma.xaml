<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../PHouse/PTool.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <StackPanel x:Key="PGamma" x:Shared="False" Margin="12,12,12,12" Visibility="Collapsed">
        <CheckBox x:Name="PGammaActive"
                  FontSize="12"
                  FontFamily="{StaticResource PToolFont}"
                  Foreground="{StaticResource PToolText}"
                  VerticalContentAlignment="Center" />
        <Border Height="1" Background="{StaticResource PToolLine}" Margin="0,12,0,12" />
        <StackPanel x:Name="PGammaStack">
            <Button x:Name="PGammaDefault"
                    Height="28"
                    MinWidth="64"
                    Padding="8,0,8,0"
                    FontSize="11"
                    FontFamily="{StaticResource PToolFont}"
                    HorizontalAlignment="Right" />
        </StackPanel>
    </StackPanel>

    <CheckBox x:Key="PGammaPersistent"
              x:Shared="False"
              FontSize="12"
              FontFamily="{StaticResource PToolFont}"
              Foreground="{StaticResource PToolText}"
              VerticalContentAlignment="Center" />
</ResourceDictionary>
