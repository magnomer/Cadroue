<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../PHouse/PTool.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <StackPanel x:Key="PVolume" x:Shared="False" Margin="12,12,12,12" Visibility="Collapsed">
        <CheckBox x:Name="PVolumeActive"
                  FontSize="12"
                  FontFamily="{StaticResource PToolFont}"
                  Foreground="{StaticResource PToolText}"
                  VerticalContentAlignment="Center" />
        <Border Height="1" Background="{StaticResource PToolLine}" Margin="0,12,0,12" />
        <StackPanel x:Name="PVolumeStack">
            <TextBlock x:Name="PVolumeClip"
                       FontSize="11"
                       FontFamily="{StaticResource PToolFont}"
                       Foreground="{StaticResource PToolWarn}"
                       TextWrapping="Wrap"
                       Margin="80,6,0,0"
                       Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>

    <CheckBox x:Key="PVolumePersistent"
              x:Shared="False"
              FontSize="12"
              FontFamily="{StaticResource PToolFont}"
              Foreground="{StaticResource PToolText}"
              VerticalContentAlignment="Center" />
</ResourceDictionary>
