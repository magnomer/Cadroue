<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:Double x:Key="PCheckboxShown">1</sys:Double>
    <sys:Double x:Key="PCheckboxFaded">0.45</sys:Double>
    <Visibility x:Key="PCheckboxVisible">Visible</Visibility>
    <SolidColorBrush x:Key="PCheckboxLine" Color="#D9DEE7" />
    <SolidColorBrush x:Key="PCheckboxSoft" Color="#F7F9FC" />
    <SolidColorBrush x:Key="PCheckboxText" Color="#1D2A3D" />
    <SolidColorBrush x:Key="PCheckboxAccent" Color="#4C86F7" />
    <SolidColorBrush x:Key="PCheckboxDeep" Color="#2F6BDB" />
    <SolidColorBrush x:Key="PCheckboxMuted" Color="#9AA5B4" />

    <Style x:Key="PCheckbox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource PCheckboxText}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource PCheckboxLine}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel x:Name="PCheckboxFrame"
                                Orientation="Horizontal"
                                Background="Transparent"
                                VerticalAlignment="Center">
                        <Border x:Name="PCheckboxBox"
                                Width="18"
                                Height="18"
                                Background="White"
                                BorderBrush="{StaticResource PCheckboxLine}"
                                BorderThickness="1"
                                CornerRadius="5"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Path x:Name="PCheckboxMark"
                                      Data="M 0,4.2 L 3.2,7.4 L 8.6,1.2"
                                      Stroke="White"
                                      StrokeThickness="1.9"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Opacity="0" />
                                <Border x:Name="PCheckboxDash"
                                        Width="9"
                                        Height="2"
                                        Background="White"
                                        CornerRadius="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="PCheckboxLabel"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{StaticResource PCheckboxText}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
