<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="PButtonText" Color="#111827" />
    <SolidColorBrush x:Key="PButtonGlyph" Color="#26364A" />
    <SolidColorBrush x:Key="PButtonLine" Color="#D9DEE7" />
    <SolidColorBrush x:Key="PButtonGrey" Color="#F8FAFC" />
    <SolidColorBrush x:Key="PButtonGreyHover" Color="#F1F5F9" />
    <SolidColorBrush x:Key="PButtonGreyPressed" Color="#E8EEF6" />
    <SolidColorBrush x:Key="PButtonCommandHover" Color="#EEF4FC" />
    <SolidColorBrush x:Key="PButtonCommandPressed" Color="#DCE8F7" />
    <SolidColorBrush x:Key="PButtonPanelText" Color="#1D2A3D" />
    <SolidColorBrush x:Key="PButtonMuted" Color="#626F83" />
    <SolidColorBrush x:Key="PButtonWhiteHover" Color="#F8FAFC" />
    <SolidColorBrush x:Key="PButtonWhitePressed" Color="#F0F4FA" />
    <SolidColorBrush x:Key="PButtonChromeHover" Color="#D3E1F2" />
    <SolidColorBrush x:Key="PButtonChromePressed" Color="#C2D4EA" />
    <SolidColorBrush x:Key="PButtonExitHover" Color="#E81123" />
    <SolidColorBrush x:Key="PButtonExitPressed" Color="#C50F1F" />
    <SolidColorBrush x:Key="PButtonInk" Color="White" />
    <sys:Double x:Key="PButtonFade">0.35</sys:Double>

    <Style x:Key="PButtonSource" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Background" Value="{StaticResource PButtonGrey}" />
        <Setter Property="Foreground" Value="{StaticResource PButtonText}" />
        <Setter Property="BorderBrush" Value="{StaticResource PButtonLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PButtonFrame" CornerRadius="8">
                        <Grid>
                            <Border x:Name="PButtonPlate" CornerRadius="7.5" />
                            <ContentPresenter x:Name="PButtonFace"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PButtonCommand" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PButtonFrame" CornerRadius="8">
                        <Grid>
                            <Border x:Name="PButtonPlate" CornerRadius="8" />
                            <ContentPresenter x:Name="PButtonFace"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PButtonFaded" TargetType="Button" BasedOn="{StaticResource PButtonCommand}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PButtonFrame" CornerRadius="8">
                        <Grid>
                            <Border x:Name="PButtonPlate" CornerRadius="8" />
                            <ContentPresenter x:Name="PButtonFace"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PButtonPanel" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PButtonPanelText}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PButtonFrame">
                        <Grid>
                            <Border x:Name="PButtonPlate" />
                            <ContentPresenter x:Name="PButtonFace"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PButtonWhite" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource PButtonText}" />
        <Setter Property="BorderBrush" Value="{StaticResource PButtonLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="12,4,12,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PButtonFrame" CornerRadius="8">
                        <Grid>
                            <Border x:Name="PButtonPlate" CornerRadius="7.5" />
                            <ContentPresenter x:Name="PButtonFace"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PButtonIcon" TargetType="Button" BasedOn="{StaticResource PButtonWhite}">
        <Setter Property="Width" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="PButtonChip" TargetType="Button" BasedOn="{StaticResource PButtonWhite}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="10,0,10,0" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="PButtonChrome" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource PButtonGlyph}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PButtonFrame">
                        <Grid>
                            <Border x:Name="PButtonPlate" />
                            <ContentPresenter x:Name="PButtonFace"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PButtonChromeFirst" TargetType="Button" BasedOn="{StaticResource PButtonChrome}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PButtonFrame" CornerRadius="0,0,0,9">
                        <Grid>
                            <Border x:Name="PButtonPlate" CornerRadius="0,0,0,9" />
                            <ContentPresenter x:Name="PButtonFace"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PButtonExit" TargetType="Button" BasedOn="{StaticResource PButtonChrome}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PButtonFrame">
                        <Grid>
                            <Border x:Name="PButtonPlate" />
                            <ContentPresenter x:Name="PButtonFace"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PButtonExitLast" TargetType="Button" BasedOn="{StaticResource PButtonExit}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PButtonFrame" CornerRadius="0,9,9,0">
                        <Grid>
                            <Border x:Name="PButtonPlate" CornerRadius="0,9,9,0" />
                            <ContentPresenter x:Name="PButtonFace"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
