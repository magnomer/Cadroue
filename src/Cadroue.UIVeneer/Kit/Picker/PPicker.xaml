<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PPickerLine" Color="#D9DEE7" />
    <SolidColorBrush x:Key="PPickerSoft" Color="#F7F9FC" />
    <SolidColorBrush x:Key="PPickerText" Color="#1D2A3D" />
    <SolidColorBrush x:Key="PPickerAccent" Color="#4C86F7" />
    <SolidColorBrush x:Key="PPickerMuted" Color="#9AA5B4" />

    <Style x:Key="PPicker" TargetType="Control">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid>
                        <Border x:Name="PPickerFrame"
                                Background="White"
                                BorderBrush="{StaticResource PPickerLine}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <DockPanel>
                                <ToggleButton x:Name="PPickerArrow"
                                              DockPanel.Dock="Right"
                                              Width="26"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              ClickMode="Press"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border BorderBrush="{StaticResource PPickerLine}"
                                                    BorderThickness="1,0,0,0"
                                                    Background="{StaticResource PPickerSoft}"
                                                    CornerRadius="0,10,10,0">
                                                <Path Stroke="{StaticResource PPickerText}"
                                                      StrokeThickness="1.3"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Data="M 3 4 L 6 7 L 9 4"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <TextBlock x:Name="PPickerSummary"
                                           Foreground="{StaticResource PPickerText}"
                                           VerticalAlignment="Center"
                                           Margin="14,0,10,0"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
                            <Border x:Name="PPickerSheet"
                                    Background="White"
                                    BorderBrush="{StaticResource PPickerLine}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="0,6,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                    <StackPanel x:Name="PPickerList" Margin="6" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <CheckBox x:Key="PPickerRow" x:Shared="False" Margin="8,6,8,6" />
</ResourceDictionary>
