<UserControl x:Class="Cadroue.UIVeneer.PSFader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="psFaderTrack">
            <Grid Margin="0,0,0,9" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="psFaderCaption"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            MinHeight="32">
                    <Slider x:Name="psFaderScale"
                            Width="220"
                            VerticalAlignment="Center" />
                    <TextBox x:Name="psFaderReadout"
                             Width="88"
                             Height="32"
                             Margin="12,0,0,0"
                             Padding="6,0,10,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="psFaderEntry">
            <Grid Margin="0,0,0,9" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="psFaderCaption"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <TextBox x:Name="psFaderReadout"
                         Grid.Column="1"
                         Width="120"
                         Height="32"
                         MinHeight="32"
                         Padding="6,0,10,0"
                         HorizontalAlignment="Left" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="psFaderNotice">
            <TextBlock Foreground="#626F83"
                       TextWrapping="Wrap"
                       Margin="130,-7,0,9" />
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel x:Name="psFaderRows" />
</UserControl>
