<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Cadroue.UIVeneer.PSEncoderOutput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cadroue.UIVeneer">
    <StackPanel Margin="0,0,0,18">
        <local:PSEncoderName x:Name="psOutputName" />
        <Grid Margin="0,0,0,9" MinHeight="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="psOutputLocationCaption" Foreground="#626F83" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="psOutputLocationMode" MinWidth="220" Height="32" />
                <TextBlock x:Name="psOutputLocationStatus" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#626F83" />
            </StackPanel>
        </Grid>
        <Grid x:Name="psOutputFolderRow" Margin="0,0,0,9" MinHeight="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="psOutputFolderCaption" Foreground="#626F83" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="psOutputFolderBox" MinWidth="220" Height="32" />
                <Button x:Name="psOutputFolderBrowse" Width="32" Height="32" Margin="8,0,0,0" Content="…" />
            </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,9" MinHeight="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="psOutputContainerCaption" Foreground="#626F83" VerticalAlignment="Center" />
            <ComboBox x:Name="psOutputContainerSelection" Grid.Column="1" MinWidth="260" Height="32" />
        </Grid>
        <Grid Margin="0,0,0,9" MinHeight="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="psOutputExtensionCaption" Foreground="#626F83" VerticalAlignment="Center" />
            <ComboBox x:Name="psOutputExtensionSelection" Grid.Column="1" MinWidth="260" Height="32" />
        </Grid>
        <Grid Margin="0,0,0,9" MinHeight="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="psOutputCollisionCaption" Foreground="#626F83" VerticalAlignment="Center" />
            <ComboBox x:Name="psOutputCollisionSelection" Grid.Column="1" MinWidth="260" Height="32" />
        </Grid>
        <Grid x:Name="psOutputSuffixRow" Margin="0,0,0,9" MinHeight="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="psOutputSuffixCaption" Foreground="#626F83" VerticalAlignment="Center" />
            <TextBox x:Name="psOutputSuffixBox" Grid.Column="1" MinWidth="220" Height="32" HorizontalAlignment="Left" />
        </Grid>
    </StackPanel>
</UserControl>
