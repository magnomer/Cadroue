<UserControl x:Class="Cadroue.UIVeneer.PSEncoderPicture"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cadroue.UIVeneer">
    <UserControl.Resources>
        <SolidColorBrush x:Key="psEncoderPictureMuted" Color="#626F83" />
        <SolidColorBrush x:Key="psEncoderPictureInk" Color="#1D2A3D" />
        <SolidColorBrush x:Key="psEncoderPictureAccent" Color="#4C86F7" />
        <SolidColorBrush x:Key="psEncoderPictureInactive" Color="#F0F3FA" />
        <SolidColorBrush x:Key="psEncoderPictureBright" Color="#FFFFFF" />
        <DataTemplate x:Key="psEncoderModeFacet">
            <Border Padding="16,0,16,0"
                    Cursor="Hand"
                    BorderBrush="#D9DEE7">
                <TextBlock x:Name="psEncoderModeLabel"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Margin="0,0,0,18">
        <Grid x:Name="psEncoderMode" Margin="0,0,0,9" MinHeight="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="psEncoderModeCaption"
                       Foreground="{StaticResource psEncoderPictureMuted}"
                       VerticalAlignment="Center" />
            <Border Grid.Column="1"
                    BorderBrush="#D9DEE7"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White"
                    HorizontalAlignment="Left"
                    Height="32">
                <StackPanel x:Name="psEncoderModeBar" Orientation="Horizontal" />
            </Border>
        </Grid>
        <StackPanel x:Name="psEncoderPictureRows">
            <Grid x:Name="psEncoderCodec" Margin="0,0,0,9" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="psEncoderCodecCaption"
                           Foreground="{StaticResource psEncoderPictureMuted}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <ComboBox x:Name="psEncoderCodecSelection"
                              MinWidth="260"
                              MinHeight="32"
                              Height="32"
                              HorizontalAlignment="Left" />
                    <Button x:Name="psEncoderCodecVerification"
                            Width="84"
                            Height="32"
                            Margin="8,0,0,0" />
                    <Button x:Name="psEncoderCodecResult"
                            Width="64"
                            Height="32"
                            Margin="6,0,0,0" />
                    <ProgressBar x:Name="psEncoderCodecProgress"
                                 Minimum="0"
                                 Maximum="1"
                                 Width="140"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Margin="10,0,0,0"
                                 Foreground="{x:Null}"
                                 Background="{x:Null}"
                                 BorderThickness="0"
                                 Visibility="Collapsed">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="{x:Type ProgressBar}">
                                <Border CornerRadius="4" Background="#E4E9F0" ClipToBounds="True">
                                    <Grid>
                                        <Rectangle x:Name="PART_Track" />
                                        <Border x:Name="PART_Indicator"
                                                HorizontalAlignment="Left"
                                                CornerRadius="4"
                                                Background="#4C86F7" />
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="psEncoderCodecError"
                       Foreground="#C02A2A"
                       TextWrapping="Wrap"
                       Margin="130,-7,0,9"
                       Visibility="Collapsed" />
            <Grid x:Name="psEncoderControl" Margin="0,0,0,9" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="psEncoderControlCaption"
                           Foreground="{StaticResource psEncoderPictureMuted}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="psEncoderControlSelection"
                          Grid.Column="1"
                          MinWidth="260"
                          MinHeight="32"
                          Height="32"
                          HorizontalAlignment="Left" />
            </Grid>
            <local:PSEncoderRate x:Name="psEncoderPictureRate" />
            <local:PSEncoderResolution x:Name="psEncoderPictureResolution" />
            <local:PSEncoderFramerate x:Name="psEncoderPictureFramerate" />
            <Grid x:Name="psEncoderPixel" Margin="0,0,0,9" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="psEncoderPixelCaption"
                           Foreground="{StaticResource psEncoderPictureMuted}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="psEncoderPixelSelection"
                          Grid.Column="1"
                          MinWidth="260"
                          MinHeight="32"
                          Height="32"
                          HorizontalAlignment="Left" />
            </Grid>
        </StackPanel>
        <TextBlock x:Name="psEncoderModeHint"
                   Foreground="{StaticResource psEncoderPictureMuted}"
                   TextWrapping="Wrap"
                   Margin="130,-7,0,9"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>
