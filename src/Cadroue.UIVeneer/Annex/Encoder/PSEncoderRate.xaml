<UserControl x:Class="Cadroue.UIVeneer.PSEncoderRate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cadroue.UIVeneer">
    <UserControl.Resources>
        <DataTemplate x:Key="psEncoderRateCaution">
            <TextBlock Foreground="#626F83"
                       TextWrapping="Wrap"
                       Margin="130,-7,0,9" />
        </DataTemplate>
        <DataTemplate x:Key="psEncoderRateSpeed">
            <Grid Margin="0,0,0,9" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="psEncoderRateCaption"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            MinHeight="32">
                    <Slider x:Name="psEncoderRateScale"
                            Minimum="0"
                            SmallChange="1"
                            LargeChange="1"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Width="220"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="psEncoderRateReadout"
                               Foreground="#1D2A3D"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="psEncoderRateExtra">
            <Grid Margin="0,0,0,9" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="psEncoderRateCaption"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="psEncoderRateOption"
                          Grid.Column="1"
                          MinWidth="260"
                          MinHeight="32"
                          Height="32"
                          HorizontalAlignment="Left" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <Border x:Name="psEncoderRateQuality">
            <local:PSFader x:Name="psEncoderRateFader" />
        </Border>
        <StackPanel x:Name="psEncoderRateRows" />
    </StackPanel>
</UserControl>
