<UserControl x:Class="Cadroue.UIVeneer.PSOptionsPlayback"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="PSPlaybackPreview"
                       Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSPlaybackEngine"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <ContentControl x:Name="PSPlaybackSelector" Grid.Column="1" />
            </Grid>
            <ContentControl x:Name="PSPlaybackPrimary" />
            <ContentControl x:Name="PSPlaybackAlternate" />
            <TextBlock x:Name="PSPlaybackNotice"
                       Foreground="#626F83"
                       TextWrapping="Wrap"
                       Margin="130,-7,0,9" />
        </StackPanel>

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="PSPlaybackAutoplay"
                       Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSPlaybackOpening"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <CheckBox x:Name="PSPlaybackAutomatic"
                          Grid.Column="1"
                          MinHeight="32"
                          VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="PSPlaybackVolume"
                       Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSPlaybackSharing"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <ContentControl x:Name="PSPlaybackScope" Grid.Column="1" />
            </Grid>
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSPlaybackLoudness"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Slider x:Name="PSPlaybackSlider"
                            Minimum="0"
                            Maximum="100"
                            Width="260" />
                    <TextBlock x:Name="PSPlaybackReadout"
                               Foreground="#1D2A3D"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               MinWidth="48" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="PSPlaybackMousewheel"
                       Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSPlaybackHover"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <ContentControl x:Name="PSPlaybackWheel" Grid.Column="1" />
            </Grid>
        </StackPanel>

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="PSPlaybackDragging"
                       Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSPlaybackGesture"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <CheckBox x:Name="PSPlaybackPaused"
                          Grid.Column="1"
                          MinHeight="32"
                          VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
