<UserControl x:Class="Cadroue.UIVeneer.PSGeneral"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="#626F83"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ContentControl x:Name="PSGeneralStartup"
                                    MinHeight="32"
                                    HorizontalAlignment="Left" />
                    <Control x:Name="PSGeneralSelection"
                             MinWidth="260"
                             Height="32"
                             Margin="12,0,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="#626F83"
                           VerticalAlignment="Center" />
                <CheckBox x:Name="PSGeneralRecent"
                          Grid.Column="1"
                          MinHeight="32" />
            </Grid>
        </StackPanel>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="#626F83"
                           VerticalAlignment="Center" />
                <CheckBox x:Name="PSGeneralSafety"
                          Grid.Column="1"
                          MinHeight="32" />
            </Grid>
            <TextBlock Foreground="#626F83"
                       TextWrapping="Wrap"
                       Margin="130,-7,0,9" />
        </StackPanel>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="#626F83"
                           VerticalAlignment="Center" />
                <CheckBox x:Name="PSGeneralVacancy"
                          Grid.Column="1"
                          MinHeight="32" />
            </Grid>
            <TextBlock Foreground="#626F83"
                       TextWrapping="Wrap"
                       Margin="130,-7,0,9" />
        </StackPanel>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="#626F83"
                           VerticalAlignment="Center" />
                <ContentControl x:Name="PSGeneralOrientation"
                                Grid.Column="1"
                                MinHeight="32"
                                HorizontalAlignment="Left" />
            </Grid>
        </StackPanel>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="#626F83"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="PSGeneralLanguage"
                          Grid.Column="1"
                          MinWidth="260"
                          Height="32"
                          HorizontalAlignment="Left" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
