<UserControl x:Class="Cadroue.UIVeneer.PSOptionsTimeline"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="PSTimelineOrder"
                       Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSTimelineStrip"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <ContentControl x:Name="PSTimelineArrangement" Grid.Column="1" />
            </Grid>
        </StackPanel>

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="PSTimelineSpacing"
                       Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSTimelineMinimum"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Slider x:Name="PSTimelineDistance"
                            Minimum="1"
                            Maximum="50"
                            Width="260" />
                    <TextBlock x:Name="PSTimelinePixels"
                               Foreground="#1D2A3D"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               MinWidth="48" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="PSTimelineDelay"
                       Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSTimelineWait"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Slider x:Name="PSTimelineDuration"
                            Minimum="0"
                            Maximum="5000"
                            Width="260" />
                    <TextBlock x:Name="PSTimelineMilliseconds"
                               Foreground="#1D2A3D"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               MinWidth="48" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="PSTimelineNotice"
                       Foreground="#626F83"
                       TextWrapping="Wrap"
                       Margin="130,-7,0,9" />
        </StackPanel>

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="PSTimelineOverlapping"
                       Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSTimelineSections"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <CheckBox x:Name="PSTimelineOverlap"
                          Grid.Column="1"
                          MinHeight="32"
                          VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="PSTimelineWaveform"
                       Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSTimelineDisplay"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <CheckBox x:Name="PSTimelineTrace"
                          Grid.Column="1"
                          MinHeight="32"
                          VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="PSTimelineCaution"
                       Foreground="#626F83"
                       TextWrapping="Wrap"
                       Margin="130,-7,0,9" />
        </StackPanel>

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="PSTimelinePalette"
                       Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <ContentControl x:Name="PSTimelineEditor" />
        </StackPanel>
    </StackPanel>
</UserControl>
