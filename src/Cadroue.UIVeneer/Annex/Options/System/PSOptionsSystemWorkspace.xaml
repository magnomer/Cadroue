<UserControl x:Class="Cadroue.UIVeneer.PSOptionsSystemWorkspace"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Button x:Key="PSSystemDone"
                Style="{DynamicResource PButtonWhite}"
                Width="190"
                Height="32" />
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,18">
        <TextBlock x:Name="PSWorkspaceTitle"
                   Foreground="#1D2A3D"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />
        <Grid MinHeight="32" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PSWorkspaceLocation"
                       Foreground="#626F83"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <TextBox x:Name="PSWorkspaceBox"
                         Style="{DynamicResource PTextbox}"
                         Width="320"
                         MinHeight="32" />
                <Button x:Name="PSWorkspaceBrowse"
                        Style="{DynamicResource PButtonWhite}"
                        Width="40"
                        Height="32"
                        Padding="0"
                        Margin="8,0,0,0" />
                <Button x:Name="PSWorkspaceOpener"
                        Style="{DynamicResource PButtonWhite}"
                        Width="40"
                        Height="32"
                        Padding="0"
                        Margin="6,0,0,0" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="PSWorkspaceDefault"
                   Foreground="#626F83"
                   TextWrapping="Wrap"
                   Margin="130,-7,0,9" />
        <Grid MinHeight="32" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PSWorkspaceCurrent"
                       Foreground="#626F83"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="PSWorkspaceSize"
                       Grid.Column="1"
                       Foreground="#626F83"
                       VerticalAlignment="Center" />
        </Grid>
        <Grid MinHeight="32" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PSWorkspaceMaintenance"
                       Foreground="#626F83"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="PSWorkspaceCleaner"
                        Style="{DynamicResource PButtonWhite}"
                        Width="190"
                        Height="32" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="PSSystemMaintenance"
                   Foreground="#626F83"
                   TextWrapping="Wrap"
                   Margin="130,-7,0,9" />
    </StackPanel>
</UserControl>
