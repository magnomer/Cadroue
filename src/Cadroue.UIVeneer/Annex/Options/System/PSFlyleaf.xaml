<UserControl x:Class="Cadroue.UIVeneer.PSFlyleaf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinHeight="32"
          Margin="0,0,0,9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Foreground="#626F83"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Button x:Name="PSFlyleafInstaller"
                    Width="160"
                    Height="32"
                    Margin="0,0,8,0" />
            <Button x:Name="PSFlyleafOpener"
                    Width="40"
                    Height="32"
                    Padding="0" />
            <ProgressBar x:Name="PSFlyleafProgress"
                         Minimum="0"
                         Maximum="1"
                         Width="220"
                         Height="8"
                         VerticalAlignment="Center"
                         Margin="16,0,0,0"
                         Foreground="{x:Null}"
                         Background="{x:Null}"
                         BorderThickness="0"
                         Visibility="Collapsed">
                <ProgressBar.Template>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Border CornerRadius="4"
                                Background="#E4E9F0"
                                ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="4"
                                        Background="#4C86F7" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>
        </StackPanel>
    </Grid>
</UserControl>
