<UserControl x:Class="Cadroue.UIVeneer.PSOptionsSystem"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cadroue.UIVeneer">
    <StackPanel>
        <local:PSRenderer x:Name="PSSystemRenderer" />
        <local:PSOptionsSystemWorkspace x:Name="PSSystemWorkspace" />

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="PSSystemHistory"
                       Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSSystemUpkeep"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <ContentControl x:Name="PSSystemFinished" Grid.Column="1" />
            </Grid>
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSSystemExpiry"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <CheckBox x:Name="PSSystemPurge"
                          Grid.Column="1"
                          MinHeight="32"
                          VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="PSSystemRetention" MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSSystemAge"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Slider x:Name="PSSystemSlider"
                            Minimum="1"
                            Maximum="365"
                            Width="260" />
                    <TextBlock x:Name="PSSystemReadout"
                               Foreground="#1D2A3D"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               MinWidth="48" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="PSSystemCaution"
                       Foreground="#626F83"
                       TextWrapping="Wrap"
                       Margin="130,-7,0,9" />
        </StackPanel>

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="PSSystemLedger"
                       Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSSystemStorage"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <ContentControl x:Name="PSSystemLocation" Grid.Column="1" />
            </Grid>
            <TextBlock x:Name="PSSystemBeside"
                       Foreground="#626F83"
                       TextWrapping="Wrap"
                       Margin="130,-7,0,9" />
            <TextBlock x:Name="PSSystemScope"
                       Foreground="#626F83"
                       TextWrapping="Wrap"
                       Margin="130,-7,0,9" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSSystemService"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="PSSystemEraser"
                            Style="{DynamicResource PButtonWhite}"
                            Width="190"
                            Height="32"
                            Margin="0" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
