<UserControl x:Class="Cadroue.UIVeneer.PSOptionsWork"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="PSWorkFailure"
                       Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSWorkReaction"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <CheckBox x:Name="PSWorkPaused"
                          Grid.Column="1"
                          MinHeight="32"
                          VerticalAlignment="Center" />
            </Grid>
            <Grid MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSWorkRetry"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <CheckBox x:Name="PSWorkRepeat"
                          Grid.Column="1"
                          MinHeight="32"
                          VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="PSWorkLimit" MinHeight="32" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSWorkMaximum"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Slider x:Name="PSWorkSlider"
                            Minimum="0"
                            Maximum="10"
                            Width="260" />
                    <TextBlock x:Name="PSWorkReadout"
                               Foreground="#1D2A3D"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               MinWidth="48" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="PSWorkPriority"
                       Foreground="#1D2A3D"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <StackPanel x:Name="PSWorkLevels">
                <Grid MinHeight="32" Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PSWorkEncoding"
                               Foreground="#626F83"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="PSWorkEncoder"
                              Grid.Column="1"
                              MinWidth="260"
                              MinHeight="32"
                              Height="32"
                              HorizontalAlignment="Left" />
                </Grid>
                <Grid MinHeight="32" Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PSWorkKeyframing"
                               Foreground="#626F83"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="PSWorkKeyframer"
                              Grid.Column="1"
                              MinWidth="260"
                              MinHeight="32"
                              Height="32"
                              HorizontalAlignment="Left" />
                </Grid>
                <Grid MinHeight="32" Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PSWorkSampling"
                               Foreground="#626F83"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="PSWorkSampler"
                              Grid.Column="1"
                              MinWidth="260"
                              MinHeight="32"
                              Height="32"
                              HorizontalAlignment="Left" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
