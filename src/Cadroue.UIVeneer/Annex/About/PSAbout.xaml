<Window x:Class="Cadroue.UIVeneer.PSAbout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        MinWidth="400"
        MinHeight="400"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Background="#DCE8F7">
    <Window.Resources>
        <DataTemplate x:Key="PSAboutCredit">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PSAboutLabel"
                           Foreground="#626F83"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap">
                    <Hyperlink x:Name="PSAboutLink" />
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel x:Name="PSAboutBody"
               Background="White">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="12">
            <Button x:Name="PSAboutCloser"
                    Width="84"
                    Height="32"
                    Margin="4" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,14,18,0">
                <StackPanel HorizontalAlignment="Center"
                            Margin="0,0,0,26">
                    <Image x:Name="PSAboutMark"
                           Width="76"
                           Height="76"
                           Stretch="Uniform"
                           Margin="0,0,0,12" />
                    <TextBlock x:Name="PSAboutDeveloper"
                               FontWeight="SemiBold"
                               Foreground="#1D2A3D"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="PSAboutBrand"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#1D2A3D"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="PSAboutVersion"
                               Foreground="#626F83"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,10" />
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap">
                        <Hyperlink x:Name="PSAboutProject" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="0,0,0,18">
                    <TextBlock x:Name="PSAboutTitle"
                               Foreground="#1D2A3D"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <StackPanel x:Name="PSAboutGallery" />
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PSAboutLicense"
                                   Foreground="#626F83"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap">
                            <Hyperlink x:Name="PSAboutDocument" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
