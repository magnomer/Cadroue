<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value="%UserProfile%\.nuget\packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <auditSources>
    <clear />
    <!-- Use NuGet.org's vulnerability-only endpoint so auditing is independent
         from the package download service index. -->
    <add key="nuget.org" value="https://data.nuget.org/v3/index.json" protocolVersion="3" />
  </auditSources>
</configuration>
